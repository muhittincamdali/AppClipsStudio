<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>appclips:example.com</string>
		<string>appclips:appclip.example.com</string>
	</array>
	<key>com.apple.developer.on-demand-install-capable</key>
	<true/>
	<key>com.apple.developer.parent-application-identifiers</key>
	<array>
		<string>$(AppIdentifierPrefix)io.github.muhittincamdali.CoffeeShop</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.io.github.muhittincamdali.CoffeeShop</string>
	</array>
</dict>
</plist>
